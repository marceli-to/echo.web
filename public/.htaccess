# Deployed with the site (see deploy.sh). Text files are UTF-8: without this
# Apache sends text/plain without a charset.
AddCharset utf-8 .txt

# One address: https, without www.
# Certificate validation under /.well-known/ stays reachable over plain http.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

AddType application/manifest+json .webmanifest

# Unknown addresses get the site's own 404 page instead of Apache's
ErrorDocument 404 /404.html

# Caching. Files in /_astro/ (CSS, fonts, images) have a content hash in their name,
# so a changed file gets a new address and the old one can be kept for a year.
# Everything else keeps its address across deploys: pages are revalidated on every
# visit (a cheap 304 via ETag), so a deploy shows up immediately; icons, og.png and
# the text files are kept for a day.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=86400"
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#(^|/|\.html)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>

  # Security: browsers remember to use https for a year (only sent over https; not for subdomains,
  # since www.echo.kimiyu.ch has no certificate yet), no MIME sniffing, and other sites only see
  # the origin when someone follows a link from here.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
