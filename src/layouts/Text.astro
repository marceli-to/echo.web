---
// Privacy, Changelog, Contact: one text column in the site's style
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  /** Heading on the page; defaults to the title */
  heading?: string;
  noindex?: boolean;
}

const { title, description, eyebrow, heading = title, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <article class="mx-auto max-w-[720px] px-24 pb-120 pt-56 md:px-48 md:pt-96">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-20 text-h2 font-extrabold">{heading}</h1>
    <div class="prose-echo mt-32">
      <slot />
    </div>
  </article>
</Base>
