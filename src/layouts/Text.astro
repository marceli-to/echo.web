---
// Privacy, Changelog, Contact: a big heading, one text column
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Heading on the page; defaults to the title */
  heading?: string;
  noindex?: boolean;
}

const { title, description, heading = title, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <article class="frame pb-120 pt-48 md:pb-160 md:pt-96">
    <h1 class="max-w-[1100px] text-page font-extrabold">{heading}</h1>
    <div class="prose-echo mt-48 max-w-[720px] md:mt-72 lg:ml-[calc(296px+48px)]">
      <slot />
    </div>
  </article>
</Base>
