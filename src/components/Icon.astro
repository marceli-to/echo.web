---
// Phosphor icons (MIT), Light weight as in the app, inlined as SVG. check-square is the Fill weight, as in Figma.
// Add an icon: import it below and add it to `icons`.
import arrowUpRight from '@phosphor-icons/core/light/arrow-up-right-light.svg?raw';
import calendarBlank from '@phosphor-icons/core/light/calendar-blank-light.svg?raw';
import caretDown from '@phosphor-icons/core/light/caret-down-light.svg?raw';
import chatCircle from '@phosphor-icons/core/light/chat-circle-light.svg?raw';
import checkSquare from '@phosphor-icons/core/fill/check-square-fill.svg?raw';
import clock from '@phosphor-icons/core/light/clock-light.svg?raw';
import envelopeSimple from '@phosphor-icons/core/light/envelope-simple-light.svg?raw';
import eyeSlash from '@phosphor-icons/core/light/eye-slash-light.svg?raw';
import fileText from '@phosphor-icons/core/light/file-text-light.svg?raw';
import folderSimple from '@phosphor-icons/core/light/folder-simple-light.svg?raw';
import lockKey from '@phosphor-icons/core/light/lock-key-light.svg?raw';
import lockSimple from '@phosphor-icons/core/light/lock-simple-light.svg?raw';
import magnifyingGlass from '@phosphor-icons/core/light/magnifying-glass-light.svg?raw';
import paperclip from '@phosphor-icons/core/light/paperclip-light.svg?raw';
import shieldCheck from '@phosphor-icons/core/light/shield-check-light.svg?raw';
import users from '@phosphor-icons/core/light/users-light.svg?raw';
import x from '@phosphor-icons/core/light/x-light.svg?raw';

const icons = {
  'arrow-up-right': arrowUpRight,
  'calendar-blank': calendarBlank,
  'caret-down': caretDown,
  'chat-circle': chatCircle,
  'check-square': checkSquare,
  clock,
  'envelope-simple': envelopeSimple,
  'eye-slash': eyeSlash,
  'file-text': fileText,
  'folder-simple': folderSimple,
  'lock-key': lockKey,
  'lock-simple': lockSimple,
  'magnifying-glass': magnifyingGlass,
  paperclip,
  'shield-check': shieldCheck,
  users,
  x,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Width and height; any CSS length, e.g. "18px". Defaults to 1em. */
  size?: string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;
// Decorative: the text next to it says what it means
const svg = icons[name].replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} style="flex-shrink:0" `,
);
---

<Fragment set:html={svg} />
