---
// The fading repeats under a line of display type. Decorative, so hidden from screen readers;
// they never wrap and are clipped at the edge of the page instead.
interface Props {
  text: string;
  /** Opacity of each repeat, top to bottom */
  steps?: number[];
  /** Scroll motion: drift apart as the page leaves (hero) or fall out from under the line (closer) */
  motion?: 'disperse' | 'gather';
  class?: string;
}

// Repeats sit closer together (leading-[0.62]) than the lines of the headline
const { text, steps = [0.22, 0.1, 0.045], motion, class: className } = Astro.props;
---

{
  steps.map((opacity, i) => (
    <span aria-hidden="true" class:list={['relative block leading-[0.62] whitespace-nowrap select-none', motion === 'disperse' && 'echo-disperse', motion === 'gather' && 'echo-gather', className]} style={`opacity:${opacity};z-index:${-i - 1};--n:${i + 1}`}>
      {text}
    </span>
  ))
}

