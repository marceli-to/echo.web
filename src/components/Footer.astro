---
import { footerNav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="frame pb-48">
  <div class="label flex flex-col-reverse gap-16 border-t border-ink pt-16 text-xs tracking-[0.02em] sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} <span class="normal-case">écho</span> · Made with <span role="img" aria-label="love">❤️</span> in Zurich by <a href="https://kimiyu.ch" class="normal-case underline-offset-4 hover:text-accent hover:underline">kimiyu.ch</a></p>
    <nav aria-label="Footer">
      <ul class="flex gap-32">
        {footerNav.map(({ label, href }) => (
          <li><a href={href} class="underline-offset-4 hover:text-accent hover:underline">{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
