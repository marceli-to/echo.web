---
// One exchange in the Assistants showcase, set as a chat: the question, a short "working" line
// (what écho looked through), then the answer from the default slot. Demo data only.
interface Props {
  /** Small mono caption above the exchange */
  caption: string;
  question: string;
  /** The sources écho looked through, shown while it "works" */
  searched: string;
}

const { caption, question, searched } = Astro.props;
---

<figure class="flex flex-col gap-24 border-t border-ink pt-14 md:gap-32">
  <figcaption class="label text-grey">{caption}</figcaption>
  <div class="reveal flex gap-16 md:gap-24">
    <span class="pt-[0.35em] font-mono text-base font-bold text-grey" aria-hidden="true">Q</span>
    <blockquote class="text-quote font-extrabold">“{question}”</blockquote>
  </div>
  {/* The marker column keeps the working line aligned with the question and answer */}
  <p class="reveal flex items-center gap-16 font-mono text-[13px] text-grey md:gap-24">
    <span class="flex w-[1ch] shrink-0 justify-center text-base" aria-hidden="true"><span class="size-6 rounded-full bg-accent motion-safe:animate-pulse"></span></span>
    <span>Searching {searched}…</span>
  </p>
  <div class="reveal flex gap-16 md:gap-24">
    <span class="pt-2 font-mono text-base font-bold text-accent" aria-hidden="true">A</span>
    <div class="answer">
      <slot />
    </div>
  </div>
</figure>
