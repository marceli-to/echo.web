---
// The hero picture: écho's Recent view, built in HTML from the Figma frame "Hero visual" (46:242).
// All sizes are the app's own points (Figma's values ÷ 0.8596, the frame's scale) times --u, which scales the
// window to the width of its container: 1 pt = 100cqw / --dw. Below xl the window is drawn narrower (smaller
// --dw) instead of smaller, and parts that don't fit drop out, so the text stays readable; on a phone it is the
// list column alone, cropped at the bottom.
import Icon from './Icon.astro';

const filters = ['All', 'Mail', 'Chats', 'Files', 'Meetings'];
---

<figure
  class="window"
  role="img"
  aria-label="The écho window showing Recent: today’s meetings at the top, then mail, WhatsApp, iMessage, a PDF and a meeting in one list, newest first, and a WhatsApp chat with Sandra Brunner in the preview pane."
>
  <div class="win">
    <div class="titlebar">
      <div class="tb-left">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="app-name">écho</span>
      </div>
      <div class="tabs">
        <span class="tab active"><b>Recent</b><kbd>⌘1</kbd></span>
        <span class="tab"><b>People</b><kbd>⌘2</kbd></span>
        <span class="tab"><b>To do</b><kbd>⌘3</kbd></span>
      </div>
      <div class="tb-right">
        <span class="status"><i class="dot"></i>up to date</span>
        <span class="status"><Icon name="lock-simple" size="calc(13 * var(--u))" />on this Mac</span>
      </div>
    </div>

    <div class="body">
      <div class="list">
        <div class="upnext">
          <span class="tile"><Icon name="calendar-blank" size="calc(16.6 * var(--u))" /></span>
          <div class="event">
            <p><span class="time accent">14:00</span><span class="ev-title">Abnahme Website Atelier Brunner</span></p>
            <p class="sub">in 2 h · Zoom · Sandra Brunner</p>
          </div>
          <span class="vrule event-2"></span>
          <div class="event event-2">
            <p><span class="time">16:30</span><span class="ev-title medium">Jour fixe Relaunch</span></p>
            <p class="sub">Tom Brunner, Sandra Brunner</p>
          </div>
          <span class="spacer"></span>
          <span class="label upnext-label">Up next · today</span>
        </div>

        <div class="filters">
          {filters.map((f, i) => <span class:list={['pill', { active: i === 0 }]}>{f}</span>)}
          <span class="spacer"></span>
          <span class="who">people you know <Icon name="caret-down" size="calc(11 * var(--u))" /></span>
          <span class="search-btn"><b>Search</b><kbd>⌘K</kbd></span>
        </div>

        <div class="day"><span class="label">Today</span><span class="count">4 · 11 messages</span></div>

        <div class="row selected">
          <span class="avatar tint">SB</span>
          <div class="text">
            <p class="top"><b>Sandra Brunner</b><span>09:41</span></p>
            <p class="meta"><Icon name="chat-circle" size="calc(12 * var(--u))" />WhatsApp · 4 messages · 09:12–09:41</p>
            <p class="msg">You: Perfekt, danke!</p>
          </div>
        </div>
        <div class="row">
          <span class="avatar">TB</span>
          <div class="text">
            <p class="top"><b>Tom Brunner</b><span>08:55</span></p>
            <p class="meta"><Icon name="envelope-simple" size="calc(12 * var(--u))" />Mail · Re: Hosting-Umzug · 3 messages</p>
            <p class="msg">Kannst du die DNS-Einträge bis Freitag umstellen? Dann machen wir den Umzug am Wochenende.</p>
          </div>
        </div>
        <div class="row">
          <span class="avatar file"><Icon name="file-text" size="calc(19 * var(--u))" /></span>
          <div class="text">
            <p class="top"><b>Offerte_2026-031_Wartung.pdf</b><span>08:30</span></p>
            <p class="meta"><Icon name="file-text" size="calc(12 * var(--u))" />updated in Atelier Brunner · 2 pages</p>
            <p class="msg">Pos. 1 Hosting, Updates und Monitoring pauschal CHF 180.– pro Monat</p>
          </div>
        </div>
        <div class="row">
          <span class="avatar">LM</span>
          <div class="text">
            <p class="top"><b>Lea Meier</b><span>07:58</span></p>
            <p class="meta"><Icon name="chat-circle" size="calc(12 * var(--u))" />iMessage · 2 messages</p>
            <p class="msg">Die Fotos für die Website sind im Ordner. Sag mir, welche du nimmst 📸</p>
          </div>
        </div>

        <div class="day"><span class="label">Yesterday</span><span class="count">3</span></div>

        <div class="row">
          <span class="avatar file"><Icon name="calendar-blank" size="calc(19 * var(--u))" /></span>
          <div class="text">
            <p class="top"><b>Jour fixe Relaunch</b><span>16:30</span></p>
            <p class="meta"><Icon name="calendar-blank" size="calc(12 * var(--u))" />Meeting · 30 min · Sandra, Tom and you</p>
            <p class="msg">Notes: Header-Bild final, Go-live am 24. Nov.</p>
          </div>
        </div>
        <div class="row">
          <span class="avatar">SB</span>
          <div class="text">
            <p class="top"><b>Sandra Brunner</b><span>10:05</span></p>
            <p class="meta"><Icon name="envelope-simple" size="calc(12 * var(--u))" />Mail · Wartung &amp; Betrieb 2027 · You → Sandra</p>
            <p class="msg">Anbei unsere Offerte für Wartung und Betrieb im nächsten Jahr. Hosting, Updates und Monitoring sind pauschal enthalten.</p>
            <span class="attachment"><Icon name="paperclip" size="calc(12 * var(--u))" />Offerte_2026-031_Wartung.pdf</span>
          </div>
        </div>
      </div>

      <div class="preview">
        <p class="label">WhatsApp · today</p>
        <p class="pv-title">Sandra Brunner</p>
        <dl class="pv-meta">
          <div><dt>with</dt><dd>Sandra Brunner</dd></div>
          <div><dt>date</dt><dd>21 Nov 2026</dd></div>
        </dl>
        <div class="chat">
          <p class="chat-date">21 Nov · 09:41</p>
          <p class="bubble in">Hast du die Mail von gestern gesehen?</p>
          <p class="bubble out">Ja, CHF 180 für die <b>Wartung passt</b> für uns.</p>
          <p class="bubble in">Super, dann unterschreibe ich die Offerte heute noch.</p>
          <p class="bubble out">Perfekt, danke!</p>
          <p class="more">+ 2 earlier · 1 later</p>
        </div>
        <div class="actions">
          <span class="open-btn"><b>Open in WhatsApp</b><kbd>↵</kbd></span>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  /* Unscaled frame: radius, border and shadow from Figma at their rendered size */
  .window {
    container-type: inline-size;
    margin: 0;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-ground);
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.08),
      0 30px 80px rgb(20 26 23 / 0.18);
  }

  .win {
    /* Phone: the list column alone, drawn 430 pt wide */
    --dw: 430;
    --h: 640;
    --pw: 0;
    --u: calc(100cqw / var(--dw));
    display: flex;
    flex-direction: column;
    height: calc(var(--h) * var(--u));
    font-family: var(--font-sans);
    color: var(--color-ink);
    line-height: 1.4;
    text-align: left;
    cursor: default;
    user-select: none;
  }
  .win p {
    margin: 0;
  }
  .win kbd {
    font-family: var(--font-mono);
    font-weight: 400;
  }
  .win b {
    font-weight: 600;
  }
  .spacer {
    flex: 1 0 0;
  }
  .label {
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    letter-spacing: calc(1.2 * var(--u));
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* Title bar with the three views as tabs */
  .titlebar {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    height: calc(48 * var(--u));
    padding: 0 calc(18 * var(--u)) 0 calc(20 * var(--u));
    border-bottom: 1px solid var(--color-line);
    flex-shrink: 0;
  }
  .tb-left {
    display: flex;
    align-items: center;
    gap: calc(20 * var(--u));
    flex: 1 0 0;
    min-width: max-content;
  }
  .lights {
    display: flex;
    gap: calc(8 * var(--u));
  }
  .lights i {
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
    border-radius: 50%;
    box-shadow: inset 0 0 0 calc(1 * var(--u)) rgb(0 0 0 / 0.1);
  }
  .lights i:nth-child(1) { background: #ff5e57; }
  .lights i:nth-child(2) { background: #ffbd2e; }
  .lights i:nth-child(3) { background: #29c740; }
  .app-name {
    font-size: calc(15 * var(--u));
    font-weight: 700;
  }
  .tabs {
    display: flex;
    gap: calc(2 * var(--u));
    padding: calc(3 * var(--u));
    border-radius: calc(10 * var(--u));
    background: rgb(0 0 0 / 0.06);
  }
  .tab {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    padding: calc(6 * var(--u)) calc(12 * var(--u)) calc(6 * var(--u)) calc(14 * var(--u));
    border-radius: calc(8 * var(--u));
    color: var(--color-muted);
    white-space: nowrap;
  }
  .tab b {
    font-size: calc(13 * var(--u));
  }
  .tab kbd {
    font-size: calc(10.5 * var(--u));
  }
  .tab.active {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 calc(1 * var(--u)) calc(3 * var(--u)) rgb(0 0 0 / 0.08);
  }
  .tab.active kbd {
    color: var(--color-muted);
  }
  .tb-right {
    display: none;
    justify-content: flex-end;
    gap: calc(14 * var(--u));
    flex: 1 0 0;
    min-width: 0;
  }
  .status {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
    white-space: nowrap;
  }
  .dot {
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border-radius: 50%;
    background: #4db059;
  }

  .body {
    display: flex;
    flex: 1 0 0;
    min-height: 0;
  }

  /* Recent list */
  .list {
    flex: 1 0 0;
    min-width: 0;
    padding: calc(24 * var(--u)) calc(32 * var(--u)) 0;
    overflow: hidden;
  }
  .upnext {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--u));
    padding: calc(14 * var(--u)) calc(18 * var(--u)) calc(14 * var(--u)) calc(16 * var(--u));
    border-radius: calc(14 * var(--u));
    background: var(--color-surface);
  }
  .tile {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: calc(32 * var(--u));
    height: calc(32 * var(--u));
    border-radius: calc(9 * var(--u));
    background: var(--color-tile);
  }
  .event {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
    min-width: 0;
    white-space: nowrap;
  }
  .event p:first-child {
    display: flex;
    align-items: baseline;
    gap: calc(8 * var(--u));
  }
  .time {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: calc(12 * var(--u));
    color: var(--color-muted);
  }
  .time.accent {
    color: var(--color-accent);
  }
  .ev-title {
    font-size: calc(14 * var(--u));
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ev-title.medium {
    font-weight: 500;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
  }
  .vrule {
    width: 1px;
    height: calc(30 * var(--u));
    background: var(--color-line);
    flex-shrink: 0;
  }
  .event-2,
  .upnext-label {
    display: none;
  }

  .filters {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    padding: calc(20 * var(--u)) 0 calc(4 * var(--u));
  }
  .pill {
    display: flex;
    align-items: center;
    height: calc(30 * var(--u));
    padding: 0 calc(13 * var(--u));
    border-radius: calc(19 * var(--u));
    background: var(--color-surface);
    font-size: calc(13 * var(--u));
    font-weight: 600;
    white-space: nowrap;
  }
  .pill.active {
    background: var(--color-ink);
    color: var(--color-ground);
  }
  .who,
  .search-btn {
    display: none;
  }
  .who {
    align-items: center;
    gap: calc(4 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
    white-space: nowrap;
  }
  .search-btn {
    align-items: center;
    gap: calc(8 * var(--u));
    height: calc(28 * var(--u));
    padding: 0 calc(11 * var(--u));
    border: 1px solid var(--color-line);
    border-radius: calc(8 * var(--u));
    background: var(--color-surface);
    white-space: nowrap;
  }
  .search-btn b {
    font-size: calc(13 * var(--u));
  }
  .search-btn kbd {
    font-size: calc(11 * var(--u));
  }

  .day {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(22 * var(--u)) calc(16 * var(--u)) calc(8 * var(--u));
  }
  .count {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: calc(14 * var(--u));
    padding: calc(14 * var(--u)) calc(16 * var(--u));
    border: 1px solid transparent;
    border-radius: calc(12 * var(--u));
  }
  .row.selected {
    background: var(--color-surface);
    border-color: rgb(30 38 33 / 0.14);
    box-shadow: 0 calc(3 * var(--u)) calc(5 * var(--u)) rgb(0 0 0 / 0.05);
  }
  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    border-radius: 50%;
    background: var(--color-tile);
    font-size: calc(14.4 * var(--u));
    font-weight: 800;
    line-height: 1;
  }
  .avatar.tint {
    background: var(--color-accent-tint);
  }
  .avatar.file {
    border-radius: calc(11 * var(--u));
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(4 * var(--u));
    flex: 1 0 0;
    min-width: 0;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(8 * var(--u));
    width: 100%;
  }
  .top b {
    font-size: calc(15.5 * var(--u));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .top span,
  .meta {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
    white-space: nowrap;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    width: 100%;
    overflow: hidden;
  }
  .msg {
    width: 100%;
    font-size: calc(14 * var(--u));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .attachment {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    padding: calc(4 * var(--u)) calc(10 * var(--u)) calc(4 * var(--u)) calc(8 * var(--u));
    border-radius: calc(8 * var(--u));
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    white-space: nowrap;
  }
  .attachment :global(svg) {
    color: var(--color-muted);
  }

  /* Preview pane: the selected WhatsApp chat */
  .preview {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    width: calc(var(--pw) * var(--u));
    padding: calc(36 * var(--u)) calc(36 * var(--u)) calc(28 * var(--u));
    border-left: 1px solid var(--color-line);
  }
  .pv-title {
    padding: calc(10 * var(--u)) 0 calc(12 * var(--u));
    font-size: calc(24 * var(--u));
    font-weight: 700;
    line-height: 1.2;
  }
  .pv-meta {
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--u));
    margin: 0;
  }
  .pv-meta div {
    display: flex;
    align-items: baseline;
  }
  .pv-meta dt {
    width: calc(64 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--color-muted);
  }
  .pv-meta dd {
    margin: 0;
    font-size: calc(14.5 * var(--u));
    font-weight: 500;
  }
  .chat {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    flex: 1 0 0;
    min-height: 0;
    margin-top: calc(20 * var(--u));
    padding: calc(20 * var(--u)) calc(18 * var(--u));
    border-radius: calc(14 * var(--u));
    background: var(--color-surface);
    overflow: hidden;
  }
  .chat-date,
  .more {
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    color: var(--color-muted);
    text-align: center;
  }
  .more {
    font-size: calc(11 * var(--u));
    color: var(--color-accent);
  }
  .bubble {
    max-width: calc(340 * var(--u));
    padding: calc(11 * var(--u)) calc(20 * var(--u));
    border-radius: calc(16 * var(--u));
    font-size: calc(14.5 * var(--u));
    font-weight: 500;
  }
  .bubble.in {
    align-self: flex-start;
    background: var(--color-surface-2);
  }
  .bubble.out {
    align-self: flex-end;
    background: var(--color-accent);
    color: #fff;
  }
  .bubble b {
    font-weight: 700;
  }
  .actions {
    padding-top: calc(24 * var(--u));
  }
  .open-btn {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--u));
    height: calc(34 * var(--u));
    padding: 0 calc(14 * var(--u));
    border-radius: calc(8 * var(--u));
    background: var(--color-accent);
    color: #fff;
    white-space: nowrap;
  }
  .open-btn b {
    font-size: calc(14 * var(--u));
  }
  .open-btn kbd {
    font-size: calc(11 * var(--u));
    opacity: 0.6;
  }

  /* Tablet: list and preview, the right part of the title bar, a shorter "Up next" */
  @media (width >= 48rem) {
    .win {
      --dw: 940;
      --h: 700;
      --pw: 380;
    }
    .preview {
      display: flex;
    }
    .tb-right,
    .who,
    .search-btn {
      display: flex;
    }
  }
  @media (width >= 64rem) {
    .win {
      --dw: 1180;
      --h: 780;
      --pw: 480;
    }
    .event-2 {
      display: flex;
    }
  }
  /* Desktop: the Figma frame, 1396 × 860 pt */
  @media (width >= 80rem) {
    .win {
      --dw: 1396;
      --h: 860;
      --pw: 560;
    }
    .upnext-label {
      display: block;
    }
  }
</style>
