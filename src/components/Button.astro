---
// A black slab with a quiet arrow. With an href it is a link; without one it is a plain label
// (the "Coming soon" buttons), not a dead link.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  /** Stretch to the container's width (phone hero) */
  block?: boolean;
}

const { block = false, href, class: className, ...rest } = Astro.props;

const classes = [
  'group inline-flex items-center gap-12 bg-ink px-24 py-16 text-base font-bold leading-[1.4] whitespace-nowrap text-paper',
  block && 'w-full justify-between sm:w-auto',
  href && 'transition-colors hover:bg-accent',
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
      <span class="font-mono font-normal opacity-50 transition-transform group-hover:translate-x-2" aria-hidden="true">→</span>
    </a>
  ) : (
    <span class:list={classes}>
      <slot />
      <span class="font-mono font-normal opacity-50" aria-hidden="true">→</span>
    </span>
  )
}
