---
import { nav } from '../data/site';
---

{/* Masthead, sticky on paper: wordmark, the index of the page, and the status */}
<header class="sticky top-0 z-40 border-b border-ink bg-paper">
  <div class="frame flex items-center justify-between gap-24 py-16 md:py-22">
    <a href="/" class="text-[22px] font-extrabold leading-none tracking-[-0.03em] md:text-2xl">écho</a>
    <nav aria-label="Sections" class="hidden lg:block">
      <ul class="label flex gap-32 text-xs tracking-[0.02em]">
        {nav.map(({ label, href }) => (
          <li><a href={href} class="underline-offset-4 hover:text-accent hover:underline">{label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="label flex items-center gap-8 text-[11px] tracking-[0.02em] md:text-xs">
      <span class="size-8 rounded-full bg-accent" aria-hidden="true"></span>
      Coming soon<span class="hidden md:inline"> · macOS 26</span>
    </p>
  </div>
</header>
