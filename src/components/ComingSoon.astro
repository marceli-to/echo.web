---
// Stand-in for the download button until there is a public build: same look, not a link.
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
  /** Full width on phones */
  block?: boolean;
  /** Align the requirements line under the button */
  align?: 'start' | 'end';
  class?: string;
}

const { block = false, align = 'end', class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-14', align === 'end' ? 'sm:items-end' : 'items-start', className]}>
  <Button block={block}>Coming soon</Button>
  <p class:list={['font-mono text-xs leading-[1.5] text-grey', align === 'end' && 'sm:text-right']}>
    {site.requirements.split(' · ').slice(0, 2).join(' · ')}<br class="hidden sm:inline" /><span class="sm:hidden"> · </span>{site.requirements.split(' · ')[2]}
  </p>
</div>
