---
import Base from '../layouts/Base.astro';
import AskExample from '../components/AskExample.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Echo from '../components/Echo.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { faq } from '../data/site';

// What a search for "fferte" turns up: the match is set in the accent
const results = [
  { date: '21 Nov', source: 'Mail', who: 'Sandra Brunner', before: 'Re: ', match: 'Offerte', after: ' Dachsanierung, Variante B' },
  { date: '18 Nov', source: 'WhatsApp', who: 'Tom Brunner', before: 'Hast du die ', match: 'Offerte', after: ' schon weitergeleitet?' },
  { date: '12 Nov', source: 'PDF', who: 'Atelier Brunner', before: '', match: 'Offerte', after: '_2026-114_Dach.pdf · page 2' },
  { date: '03 Nov', source: 'Calendar', who: 'Jour fixe Relaunch', before: 'Besprechung ', match: 'Offerte', after: ' und Termine' },
  { date: '29 Oct', source: 'iMessage', who: 'Lea', before: 'Die ', match: 'Offerte', after: ' kam heute, schau mal' },
];

const filters = ['with:', 'from:', 'in:mail', 'type:word', 'has:attachment', 'project:', 'after:2026', '"exact phrase"'];

const sources = [
  { name: 'Mail', note: 'Apple Mail, every mailbox you choose' },
  { name: 'WhatsApp', note: 'Chats, from the Mac app or an export' },
  { name: 'iMessage', note: 'Messages and SMS from this Mac' },
  { name: 'Signal', note: 'Chats from Signal Desktop' },
  { name: 'Files', note: 'PDFs, Word, text and more from your folders; scans read with OCR' },
  { name: 'Links', note: 'Bookmarks you save or drop on écho' },
  { name: 'Calendar', note: 'Meetings, with who was there' },
  { name: 'Notes', note: 'Apple Notes, except locked ones' },
  { name: 'Reminders', note: 'Open and done, with due dates' },
  { name: 'Contacts', note: 'Names and numbers that join people' },
];

const privacyPoints = [
  { title: 'Encrypted index', text: 'On your disk, its key in your Keychain.' },
  { title: 'App lock', text: 'Touch ID or your password, at launch or when idle.' },
  { title: 'Changes only what you ask', text: 'Archive or delete mail, with Undo. Never sends anything.' },
  { title: 'No account, no cloud', text: 'Nothing to sign up for, nothing to sync.' },
  { title: 'You choose what it reads', text: 'Switch sources off, leave out folders, chats or senders.' },
  { title: 'AI only if you say so', text: 'Per source, every access logged.' },
  { title: 'Delete all data', text: 'One step, confirmed with Touch ID.' },
];

const assistantRules = [
  'Off until you switch it on.',
  'You choose the sources.',
  'Read-only. It can’t send, change or delete.',
  'Your mail reaches it as other people’s words, never as orders.',
  'Names, not addresses, unless you allow them.',
  'Nothing while écho is locked.',
  'Every request is logged in écho.',
];

// As in the app: in the ⌘K panel ↵ shows the match in écho, ⌘↵ opens it in its own app
const keys = [
  { keys: '⌘K', label: 'Search in écho', tag: 'Search' },
  { keys: '↑ ↓', label: 'Move through the matches', tag: 'Search' },
  { keys: '↵', label: 'Show the match in écho', tag: 'Search' },
  { keys: '⌘↵', label: 'Open it in Mail, WhatsApp or Preview', tag: 'Search' },
  { keys: '⌘⌫', label: 'Clear the search', tag: 'Search' },
  { keys: '⌘1 ⌘2', label: 'Recent, People', tag: 'Tabs' },
  { keys: '⌃⌘L', label: 'Lock écho', tag: 'Privacy' },
];

const section = 'frame pt-96 md:pt-120 xl:pt-160';
const h3 = 'text-h2 font-extrabold';
const body = 'text-lg font-medium leading-[1.5]';
---

<Base>
  {/* Hero: the headline, its echo, then a ruled deck */}
  <section class="frame overflow-x-clip pb-48 pt-40 md:pb-96 md:pt-96" aria-labelledby="hero-title">
    <div class="isolate text-hero font-extrabold">
      <h1 id="hero-title" class="relative z-10">
        Everything<br /> you’ve written,
        <span class="block text-accent">found again.</span>
      </h1>
      <Echo text="found again." motion="disperse" />
    </div>
    <div class="mt-40 grid gap-20 border-t border-ink pt-20 md:mt-56 md:pt-28 lg:grid-cols-[296px_minmax(0,1fr)_auto] lg:gap-48">
      <p class="label hidden lg:block">A search app<br /> that stays put.</p>
      <p class="max-w-[760px] text-lead font-medium">
        écho reads your mail, chats, files, meetings, notes and reminders into one private index on your Mac. Type a few words and the
        message you half remember is there, in milliseconds.
      </p>
      <ComingSoon block />
    </div>
  </section>

  {/* 01 Search */}
  <section id="search" class={section} aria-labelledby="search-title">
    <SectionLabel title="Every word counts" aside="Search" id="search-title" />
    <p class="flex items-center overflow-clip whitespace-nowrap pb-16 pt-24 font-mono text-query font-medium md:pb-24 md:pt-48" role="img" aria-label="A search for “fferte”, which also finds “Offerte”">
      <span class="opacity-12" aria-hidden="true">O</span><span class="type-6" aria-hidden="true">fferte</span>
      <span class="ml-[0.04em] h-[0.85em] w-[0.07em] shrink-0 bg-accent motion-safe:animate-blink" aria-hidden="true"></span>
    </p>
    <div class="grid gap-48 md:pt-24 lg:grid-cols-[416px_minmax(0,1fr)]">
      <div class="flex flex-col gap-24">
        <h3 class={h3}>Type a few words. Get the right one.</h3>
        <p class={body}>
          Every word you type has to match, and any part of a word counts: “dach” finds “Dachsanierung”, “fferte”
          finds “Offerte”. Small typos are forgiven, “Strasse” finds “Straße”, a word in a title counts more, and times
          can be written as words:
          “Offerte letztes Jahr”, “Rechnung im Juni”. Built for German, French and English. Results open on the best
          match; one click switches to newest first.
        </p>
        <ul class="flex flex-wrap gap-8" aria-label="Filters">
          {filters.map((f) => <li class="border border-ink px-10 py-6 font-mono text-[13px] leading-[1.3]">{f}</li>)}
        </ul>
      </div>
      <div>
        <ol aria-label="Results for “fferte”" class="border-b border-ink">
          {
            results.map((r) => (
              <li class="reveal grid gap-4 border-t border-ink py-14 xl:grid-cols-[64px_88px_176px_minmax(0,1fr)] xl:items-baseline xl:gap-24 xl:py-18">
                <p class="font-mono text-[11px] text-grey md:text-xs xl:hidden">
                  {r.date} · <span class="uppercase">{r.source}</span> · {r.who}
                </p>
                <p class="hidden font-mono text-[13px] text-grey xl:block">{r.date}</p>
                <p class="hidden font-mono text-[13px] uppercase text-grey xl:block">{r.source}</p>
                <p class="hidden truncate text-[17px] font-bold xl:block">{r.who}</p>
                <p class="text-base font-medium xl:text-[17px]">
                  {r.before}<mark class="bg-transparent font-extrabold text-accent">{r.match}</mark>{r.after}
                </p>
              </li>
            ))
          }
        </ol>
        <p class="pt-12 font-mono text-xs text-grey">5 of 214 results · 11 ms</p>
      </div>
    </div>
  </section>

  {/* 02 Sources */}
  <section id="sources" class={section} aria-labelledby="sources-title">
    <SectionLabel title="One list, newest first" aside="Sources" id="sources-title" />
    <ol class="isolate pt-16 md:pt-24">
      {
        sources.map((s, i) => (
          <li class="relative flex flex-col gap-4 border-b border-ink/15 py-12 md:flex-row md:items-center md:justify-between md:py-8" style={`z-index:${sources.length - i}`}>
            <p class="light-up text-word font-extrabold">{s.name}</p>
            <p class="font-mono text-[13px] text-grey md:text-sm">{s.note}</p>
          </li>
        ))
      }
    </ol>
    <div class="grid gap-40 pt-48 md:grid-cols-2 md:gap-48 md:pt-64">
      <div class="flex flex-col gap-16">
        <h3 class={h3}>Recent is home.</h3>
        <p class={body}>
          Everything in one list, grouped by day, with a preview next to it. It shows the people you know; switch to
          Everyone in one click. Filter by mail, chats, files, links, meetings, notes or reminders, and today’s next meeting
          waits on top. Select a few mails to archive or delete them in Apple Mail, with Undo, or clear out a
          newsletter in one step.
        </p>
      </div>
      <div class="flex flex-col gap-16">
        <h3 class={h3}>People, not addresses.</h3>
        <p class={body}>
          Every address and number someone uses, joined into one timeline. Merge an unknown sender in, split them out
          again. Type with: and a name to see everything you exchanged.
        </p>
      </div>
    </div>
  </section>

  {/* 03 Privacy: the one full-bleed block */}
  <section id="privacy" class="bleed mt-96 bg-accent text-paper md:mt-120 xl:mt-160" aria-labelledby="privacy-title">
    <div class="frame pb-64 pt-24 md:pb-96">
      <SectionLabel title="Private by design" aside="Privacy" id="privacy-title" inverse />
      <p class="reveal pb-40 pt-40 text-statement font-extrabold md:pb-64 md:pt-48">Your index<br /> stays on<br /> this Mac.</p>
      <div class="grid gap-40 xl:grid-cols-[minmax(0,752px)_minmax(0,1fr)] xl:gap-48">
        <p class="text-lead font-medium">
          Your mail and messages are the most personal data you have. écho reads them where they already are and keeps
          its index on your disk, encrypted. No account, no cloud, no tracking. Connect your AI if you want: you choose
          which sources it can see, what it asks for goes to that assistant’s provider, and every access is logged.
          Lock écho with Touch ID, leave out what it shouldn’t read, or delete everything in one step.
        </p>
        <dl>
          {
            privacyPoints.map((p) => (
              <div class="reveal flex flex-col gap-4 border-t border-paper/35 py-14 sm:flex-row sm:justify-between sm:gap-24">
                <dt class="label">{p.title}</dt>
                <dd class="text-[15px] font-medium text-paper/80 sm:text-right">{p.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* 04 Assistants (MCP): two invented exchanges, set as chats. Demo data only */}
  <section id="assistants" class={section} aria-labelledby="assistants-title">
    <SectionLabel title="For your AI assistant" aside="MCP" id="assistants-title" />
    <div class="grid gap-56 pt-32 md:pt-48 lg:grid-cols-[416px_minmax(0,1fr)] lg:gap-48">
      <div class="flex flex-col gap-24 lg:sticky lg:top-120 lg:self-start">
        <h3 class={h3}>Ask your AI about your real work.</h3>
        <p class={body}>
          Your assistant knows what you tell it. With écho it can look up the rest: the mail, the chat, the change you
          forgot to mention. écho finds it; your assistant does the thinking.
        </p>
        <p class={body}>
          Connect écho to Claude Desktop, Claude Code or any other MCP client. Your assistant can then answer from your calendar, mail and
          chats, and écho catches it when they don’t agree. Every answer links back to the original.
        </p>
        <ul class="border-b border-ink/15">
          {
            assistantRules.map((r) => (
              <li class="flex gap-12 border-t border-ink/15 py-10 font-mono text-sm">
                <span class="text-accent" aria-hidden="true">—</span>
                {r}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-64 md:gap-96">
        <AskExample
          caption="In Claude Code. You only asked what’s next."
          question="What’s next?"
          searched="Mail, WhatsApp, Files"
        >
          <p>
            Next in <strong>progress.md</strong> is the contact form. Before you start: two things changed that aren’t
            in the notes yet.
          </p>
          <ul>
            <li>
              <strong>Thomas Keller wrote on 19 Nov</strong> that the launch moves from 1 December to
              <strong>Monday 14 December</strong>: their new photos aren’t ready. <span class="source">mail</span>
            </li>
            <li>
              <strong>On WhatsApp on 21 Nov</strong>, Sandra asked to <strong>drop the newsletter sign-up</strong> for
              now. <span class="source">chat</span>
            </li>
          </ul>
          <p>
            The contact form is still next, and the new date leaves room for it. I’d update progress.md first: the new
            launch date, and the newsletter off the list. Shall I?
          </p>
        </AskExample>
        <AskExample
          caption="Your calendar says Thursday. Your WhatsApp says Wednesday."
          question="When is my next appointment with Laura Brunner?"
          searched="Calendar, Mail, WhatsApp"
        >
          <p>
            Your next appointment with Laura Brunner is <strong>probably Wednesday 9 December</strong>, but it isn’t
            confirmed yet.
          </p>
          <ul>
            <li>
              <strong>Your calendar</strong> still has it on <strong>Thursday 10 Dec at 09:30</strong> <span class="source">event</span>.
            </li>
            <li>
              <strong>On WhatsApp on 20 Nov</strong>, you asked to move it because a client wants to meet you on the 10th,
              and offered the 9th or 11th. Laura replied at 16:43: “Ja, Mi 9.12. würde gut gehen. OK?” <span class="source">chat</span>
            </li>
          </ul>
          <p>
            I don’t see a reply from you after that. To lock it in, confirm the 9th with her, agree on a time (you usually
            meet at 09:30), and move the calendar entry.
          </p>
        </AskExample>
        <AskExample
          caption="Before the meeting: everything, from every channel."
          question="When is my appointment with Thomas Keller?"
          searched="Calendar, Mail, WhatsApp"
        >
          <p>
            Your appointment with Thomas Keller is on <strong>Thursday 3 December, 13:30–16:30</strong>, at Keller Design
            AG, Seestrasse 12, 8800 Thalwil <span class="source">event</span>.
          </p>
          <ul>
            <li>
              It’s called <strong>“TK/SM – Website Relaunch”</strong>, so it’s about the relaunch. Thomas set it up and
              you’ve accepted.
            </li>
            <li>“SM” is probably a second person, but nobody else is on the invite.</li>
          </ul>
          <p>
            The next evening there’s another plan with him: on 27 Oct he wrote on WhatsApp <strong>“Fr 4.12. 18:30 im
            Bohemia 🥳”</strong> <span class="source">chat</span>. It’s not in your calendar.
          </p>
        </AskExample>
        <p class="border-t border-ink/15 pt-14 font-mono text-[13px] text-grey">
          écho’s index stays on your Mac. When you connect your AI, you choose which sources it can see, and every access
          is logged. Names and messages above are made up.
        </p>
      </div>
    </div>
  </section>

  {/* Keys: the flow as a statement, then every shortcut in a ruled list (Figma 86:75) */}
  <section id="keys" class={section} aria-labelledby="keys-title">
    <SectionLabel title="Made for the keyboard" aside="Never reach for the mouse" id="keys-title" />
    <p class="reveal pb-32 pt-32 text-hero font-extrabold md:pb-56 md:pt-48">
      <span aria-hidden="true"><span class="font-mono font-medium tracking-[-0.06em] text-accent">⌘K</span>. Type. <span class="font-mono font-medium text-accent">↵</span>.</span>
      <span class="sr-only">Command K, type, Return.</span>
    </p>
    <div class="grid gap-20 pb-40 md:pb-72 lg:grid-cols-[296px_minmax(0,1fr)] lg:gap-48">
      <p class="label hidden lg:block">Hands on<br /> the keys.</p>
      <p class="max-w-[760px] text-lead font-medium">
        Press ⌘K and type a few words. ↵ shows the match in écho, ⌘↵ opens it where it lives. Your hands never leave
        the keyboard.
      </p>
    </div>
    <dl class="border-b border-ink">
      {
        keys.map((k, i) => (
          <div class:list={['reveal grid grid-cols-[118px_minmax(0,1fr)] items-center gap-16 border-t py-14 md:grid-cols-[296px_minmax(0,1fr)_auto] md:gap-48 md:py-20', i === 0 ? 'border-ink' : 'border-ink/15']}>
            <dt class="font-mono text-[clamp(2rem,1.443rem+2.286vw,3.5rem)] font-medium leading-none tracking-[-0.04em]">
              <kbd>{k.keys}</kbd>
            </dt>
            <dd class="text-lead font-medium">{k.label}</dd>
            <dd class="label hidden text-grey md:block">{k.tag}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* FAQ: questions on the left, answers on the right, one ruled row each */}
  <section id="faq" class={section} aria-labelledby="faq-title">
    <SectionLabel title="Questions" aside="FAQ" id="faq-title" />
    <dl class="mt-32 border-b border-ink md:mt-48">
      {
        faq.map((f, i) => (
          <div class:list={['reveal grid gap-8 border-t py-20 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-48 md:py-24', i === 0 ? 'border-ink' : 'border-ink/15']}>
            <dt class="text-lead font-extrabold">{f.q}</dt>
            <dd class={body}>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Close: the echo once more, the button */}
  <section class="frame overflow-x-clip pb-96 pt-120 md:pb-120 md:pt-200" aria-labelledby="closer-title">
    <div class="flex flex-col gap-32 md:flex-row md:items-end md:gap-48">
      <div class="isolate min-w-0 flex-1 text-closer font-extrabold">
        <h2 id="closer-title" class="relative z-10">Find it again.</h2>
        <Echo text="Find it again." steps={[0.16, 0.06]} motion="gather" />
      </div>
      <ComingSoon block />
    </div>
  </section>
</Base>

