---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not found" noindex>
  <section class="mx-auto flex max-w-[720px] flex-col items-center px-24 pb-160 pt-120 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-20 text-h2 font-extrabold">Not even écho can find this page.</h1>
    <p class="mt-20 text-lg font-medium text-muted">The address may be mistyped, or the page has moved.</p>
    <Button href="/" class="mt-32">Back to the home page</Button>
  </section>
</Base>
